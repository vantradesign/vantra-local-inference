{
  "name": "@vantra-design/local-inference",
  "version": "0.2.0",
  "description": "Shared browser-side inference runtime: WebGPU detection, WebLLM engine wrapper, and Kokoro TTS — used by @vantra-design/ask-design-system and @vantra-design/screenreader-empathy.",
  "keywords": [
    "webgpu",
    "webllm",
    "tts",
    "local-inference",
    "browser-ai",
    "design-system",
    "vantra"
  ],
  "license": "Apache-2.0",
  "author": "Vantra Design <vantra@kauper.co>",
  "homepage": "https://github.com/vantradesign/vantra-local-inference#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vantradesign/vantra-local-inference.git"
  },
  "bugs": {
    "url": "https://github.com/vantradesign/vantra-local-inference/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.18.0"
  },
  "packageManager": "pnpm@11.20.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "tsc": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm run build && changeset publish",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "^0.2.78",
    "kokoro-js": "^1.1.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@eslint/js": "^10.0.1",
    "@webgpu/types": "^0.1.55",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
